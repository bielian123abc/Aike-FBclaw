{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist/electron",
    "rootDir": ".",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@detection/*": ["src/detection/*"],
      "@memory/*": ["src/memory/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["electron/**/*"],
  "exclude": ["node_modules"]
}
